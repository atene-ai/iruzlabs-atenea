# Copy to server.env and fill in; compose.server.yml reads it through --env-file.
# server.env holds secrets: keep it 0600 and out of Git.

# Where staff open Atenea. The Cognito app client must list <PUBLIC_URL>/auth/callback
# as a callback URL and <PUBLIC_URL>/ as a sign-out URL.
PUBLIC_URL=https://ia.iruzlabs.com

# The staff pool (Zuri-Staff-prod, mx-central-1): its Hosted UI domain, its issuer and the
# app client that gateway/scripts/cognito-app-client.sh creates.
COGNITO_DOMAIN=https://<domain-prefix>.auth.mx-central-1.amazoncognito.com
COGNITO_ISSUER=https://cognito-idp.mx-central-1.amazonaws.com/<user-pool-id>
COGNITO_CLIENT_ID=
# Only for a confidential app client; the script makes a public one (PKCE).
#COGNITO_CLIENT_SECRET=

# SLA, which answers GET /api/atenea/me for a staff member's ID token.
SLA_URL=https://<sla-host>

# Shared by the gateway (which signs x-atenea-identity) and ds-bot (which checks it).
# At least 32 characters, for example: openssl rand -hex 32
ATENEA_IDENTITY_SECRET=

# Model keys for dsh (see docker/README.md, "Custom model endpoint").
#FOUNDRY_API_KEY=
#DEEPSEEK_API_KEY=

# Owner of the data and workspace folders on the host; both containers run as this user.
#PUID=1000
#PGID=1000
#DATA_DIR=./data
#WORKSPACE_DIR=./workspace

# Host port on 127.0.0.1 the reverse proxy targets.
#GATEWAY_PORT=13081
